{
  "name": "videooo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.20.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint packages apps scripts",
    "test": "pnpm build && vitest run",
    "skills:check": "node scripts/validate-skills.mjs",
    "check": "pnpm skills:check && pnpm typecheck && pnpm lint && pnpm test",
    "install:cli": "node scripts/install-cli.mjs",
    "render:smoke": "pnpm build && node scripts/render-smoke.mjs",
    "mixed:smoke": "pnpm build && node scripts/mixed-render-smoke.mjs",
    "qa:smoke": "pnpm build && node scripts/qa-smoke.mjs",
    "videooo": "node apps/cli/.build/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "oxlint": "1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
